# Copy to .env.local for local development. Never commit real values.

# Public URL of the site (used for metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string — leads are stored here.
# Optional in local dev: without it, submissions are only logged to the terminal.
DATABASE_URL=

# Resend — sends the owner notification + customer confirmation.
# Optional in local dev: without it, emails are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM="Hantari <notifications@send.hantari.ro>"
LEADS_NOTIFY_TO=hello@hantari.ro

# Show only the "Coming soon" holding page on every route (redeploy after changing)
COMING_SOON=false
